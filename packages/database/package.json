{
  "name": "@bizbot/database",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "dotenv -e ../../.env drizzle-kit push",
    "db:studio": "dotenv -e ../../.env drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:seed-kb": "tsx --env-file=../../.env src/seed-kb.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.1",
    "@neondatabase/serverless": "^0.10.4",
    "@bizbot/ai-prompts": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
