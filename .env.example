# ===========================
# DATABASE (Neon PostgreSQL)
# ===========================
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ===========================
# REDIS (Upstash)
# ===========================
REDIS_URL=rediss://default:xxx@apn1-xxx.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://apn1-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ===========================
# WHATSAPP (Meta Cloud API)
# ===========================
WA_PHONE_NUMBER_ID=xxx
WA_BUSINESS_ACCOUNT_ID=xxx
WA_ACCESS_TOKEN=xxx
WA_WEBHOOK_VERIFY_TOKEN=your_random_string
WA_APP_SECRET=xxx

# ===========================
# AI (Anthropic Claude)
# ===========================
ANTHROPIC_API_KEY=sk-ant-xxx

# ===========================
# PAYMENTS (Razorpay)
# ===========================
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ===========================
# EMAIL (Resend)
# ===========================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===========================
# AUTH (Auth.js v5)
# ===========================
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=xxx
AUTH_GOOGLE_SECRET=xxx

# ===========================
# STORAGE (Cloudflare R2)
# ===========================
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=bizbot-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ===========================
# MONITORING (Sentry)
# ===========================
SENTRY_DSN_BACKEND=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_WEB=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================
# APP CONFIG
# ===========================
NODE_ENV=development
APP_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:3001
